# Local config / secrets
*.local.*
*.local

# Dependencies (no trailing slash: also ignores node_modules SYMLINKS, e.g.
# ts/node_modules -> shared tree, which a dir-only rule leaves tracked)
node_modules

# Logs
*.log
logs/

# OS
.DS_Store

# Editor
*~
*.swp

# Source-only assessment; build locally with npm --prefix ts test.
ts/dist/
ts/dist-test/
.jostraca/
.sdk/.jostraca/
.sdk/model/.model-config/
.sdk/test/.model-config/
