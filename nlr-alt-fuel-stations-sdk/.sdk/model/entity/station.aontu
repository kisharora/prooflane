# Entity: station

main: kit: entity: station: {

  alias: field: {}

  fields: {
    city: {
      h: "City"
      n: "city"
      r: false
      t: "`$STRING`"
    }
    fuel_type_code: {
      h: "Fuel Type Code"
      n: "fuel_type_code"
      r: false
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$INTEGER`"
    }
    latitude: {
      h: "Latitude"
      n: "latitude"
      r: false
      t: "`$NUMBER`"
    }
    longitude: {
      h: "Longitude"
      n: "longitude"
      r: false
      t: "`$NUMBER`"
    }
    state: {
      h: "State"
      n: "state"
      r: false
      t: "`$STRING`"
    }
    station_name: {
      h: "Station Name"
      n: "station_name"
      r: false
      t: "`$STRING`"
    }
    street_address: {
      h: "Street Address"
      n: "street_address"
      r: false
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "station"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /alt-fuel-stations/v1.json"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "fuel_type"
                or: "fuel_type"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "state"
                or: "state"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/alt-fuel-stations/v1.json"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "alt-fuel-stations"
            }
            {
              lit: "v1.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.fuel_stations`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /alt-fuel-stations/v1/{id}.json"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/alt-fuel-stations/v1/{id}.json"
          q: {
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "alt-fuel-stations"
            }
            {
              lit: "v1"
            }
            {
              lit: "{id}.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.alt_fuel_station`"
          }
        }
      ]
    }
  }



}
